<?xml version="1.0" encoding="utf-8"?>
<!--
    CasparCG Test Configuration for macOS

    This configuration is designed for running self-tests on macOS.
    Phase 9: Screen consumer enabled with GCD main thread marshaling.

    Copy this to your CasparCG directory as casparcg.config before running tests.

    Channel 1: Main playback channel with Screen and NDI output
    Channel 2: NDI loopback test - receives NDI from Ch1, outputs to Screen

    To test NDI loopback:
      PLAY 1-1 COLOR RED
      PLAY 2-1 [NDI] "HOSTNAME (CasparCG-Ch1)"
-->
<configuration>
    <paths>
        <media-path>../../tests/testmedia/</media-path>
        <log-path>log/</log-path>
        <data-path>data/</data-path>
        <template-path>../../tests/template/</template-path>
    </paths>

    <lock-clear-phrase>secret</lock-clear-phrase>

    <channels>
        <!-- Channel 1: Main playback with Screen and NDI consumers -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <system-audio />
                <screen>
                    <device>1</device>
                    <windowed>true</windowed>
                    <width>960</width>
                    <height>540</height>
                </screen>
                <ndi>
                    <name>CasparCG-Ch1</name>
                </ndi>
            </consumers>
        </channel>

        <!-- Channel 2: NDI loopback - receives from Ch1, outputs to Screen -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <screen>
                    <device>2</device>
                    <windowed>true</windowed>
                    <width>960</width>
                    <height>540</height>
                    <x>980</x>
                    <y>0</y>
                </screen>
            </consumers>
        </channel>
    </channels>

    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>

    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients />
    </osc>
</configuration>
