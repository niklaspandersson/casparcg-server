<?xml version="1.0" encoding="utf-8"?>
<!--
    CasparCG Test Configuration

    This configuration is designed for running self-tests.
    Copy this to your CasparCG directory as casparcg.config before running tests.

    Channel 1: Main playback channel with screen output
    Channel 2: Secondary channel for routing tests
-->
<configuration>
    <paths>
        <media-path>../../tests/testmedia/</media-path>
        <log-path>log/</log-path>
        <data-path>data/</data-path>
        <template-path>../../tests/template/</template-path>
    </paths>

    <lock-clear-phrase>secret</lock-clear-phrase>

    <channels>
        <!-- Channel 1: Main playback + screen output -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <screen>
                    <device>1</device>
                    <windowed>true</windowed>
                    <name>CasparCG Test - Channel 1</name>
                </screen>
                <system-audio />
            </consumers>
        </channel>

        <!-- Channel 2: Secondary channel (can route from ch1) -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <screen>
                    <device>1</device>
                    <windowed>true</windowed>
                    <name>CasparCG Test - Channel 2</name>
                </screen>
            </consumers>
        </channel>
    </channels>

    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>

    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients />
    </osc>
</configuration>
