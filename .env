# CasparCG macOS Signing and Notarization Configuration
#
# Copy this file to .env and fill in your values.
#
# SETUP: First, store your credentials in keychain (one-time):
#
#   xcrun notarytool store-credentials "CasparCG-Notarize" \
#       --apple-id "your@email.com" \
#       --team-id "TEAMID" \
#       --password "xxxx-xxxx-xxxx-xxxx"
#
# To create an app-specific password:
#   1. Go to https://appleid.apple.com
#   2. Sign in and go to "App-Specific Passwords"
#   3. Generate a new password
#
# To find your signing identity:
#   security find-identity -v -p codesigning

# Code signing identity
SIGNING_IDENTITY="Developer ID Application: kasper olsson (TW59T82MFN)"

# Keychain profile name (created with xcrun notarytool store-credentials)
NOTARIZE_KEYCHAIN_PROFILE="CasparCG-Notarize"
